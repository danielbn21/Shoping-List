{
  "id": "barcode-scan",
  "name": "Barcode scanning",
  "version": "1.3.0",
  "description": "Scan a product's barcode with the phone camera to add it to the list or, while shopping, tick it off. The product name and price come from the supermarket price files read by Price comparison; a barcode is remembered once you have matched it.",
  "author": "Shopping list",
  "requires": {
    "core": ">=1.9.0 <2.0.0"
  },
  "optionalDepends": [
    "price-compare"
  ],
  "provides": [
    "item-csv-columns"
  ],
  "slots": [
    "shop.toolbar",
    "manage.toolbar",
    "trip.toolbar",
    "admin.section"
  ],
  "server": "server/index.js",
  "web": "web.js",
  "i18n": "i18n.json",
  "config": {
    "scan_per_min": {
      "type": "int",
      "min": 10,
      "max": 600,
      "default": 180
    },
    "repeat_seconds": {
      "type": "int",
      "min": 1,
      "max": 30,
      "default": 4
    },
    "save_price": {
      "type": "bool",
      "default": true
    },
    "auto_category": {
      "type": "bool",
      "default": true
    }
  }
}
